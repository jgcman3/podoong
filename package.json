{
  "name": "podung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3187",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3187",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3187",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db && node scripts/verify-feeding-cleanup.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "env:local": "node scripts/local-env.mjs",
    "format": "prettier --write src tests messages scripts *.ts *.mjs *.json README.md docs/implementation .github",
    "test:local": "node scripts/verify-local.mjs e2e",
    "operations:local": "node scripts/verify-local.mjs worker",
    "backup:verify": "node scripts/verify-local-restore.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.100.0",
    "next-intl": "4.14.9",
    "zod": "^4.3.0",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.8.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.58.0",
    "supabase": "2.120.0"
  }
}
