NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3187
# Enabled providers must also be configured in Supabase Auth.
NEXT_PUBLIC_AUTH_PROVIDERS=
# After actual provider verification: google,kakao,naver
# Server only: required for shared diary photos and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service_role alternative (same project only).
SUPABASE_SERVICE_ROLE_KEY=

# Public project reference used by env:check; set to the production project, not preview.
PODUNG_PRODUCTION_PROJECT_REF=

# Server only. Public Data Portal general authentication key (Decoding).
DATA_SERVICE_KEY=
KINDERGARTEN_API_KEY=
# Childcare API keys are issued separately per service.
# Nationwide list: cpmsapi021
CHILDCARE_API_KEY=
# Per-facility / regional basic information: cpmsapi030 (separately issued key)
CHILDCARE_DETAIL_API_KEY=
# GOV24_SERVICE_KEY is an optional override in the support worker; it can use the same key.

# Optional, server only: coarse administrative-area geocoding (no device GPS).
KAKAO_REST_API_KEY=
