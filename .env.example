NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3187
# Enabled providers must also be configured in Supabase Auth.
NEXT_PUBLIC_AUTH_PROVIDERS=
# After actual provider verification: google,kakao,naver
# Server only: required for shared diary photos and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service_role alternative (same project only).
SUPABASE_SERVICE_ROLE_KEY=

# Public project reference used by env:check; set to the production project, not preview.
PODUNG_PRODUCTION_PROJECT_REF=
